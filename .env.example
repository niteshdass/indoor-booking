MONGODB_URI=mongodb://localhost:27017/booking?replicaSet=rs0
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
# Map tiles: a keyed provider is required in production (the OpenStreetMap servers forbid it), e.g.
# https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=YOUR_KEY. Unset falls back to OpenStreetMap for development.
VITE_MAP_TILE_URL=
# The provider's own credit (HTML), shown before the OpenStreetMap credit, e.g. &copy; MapTiler
VITE_MAP_TILE_ATTRIBUTION=
# Auth: JWT_SECRET must be at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Optional fallback: set the Google client ID in Admin > Settings instead. The button is hidden while neither is set.
GOOGLE_CLIENT_ID=
# Web app URL used in password-reset links and notification messages (required in production)
APP_URL=http://localhost:5173
# Hops of reverse proxy/load balancer in front of the API, so rate limits see real client IPs (e.g. 1, loopback).
# Required in production; set false when nothing sits in front.
TRUST_PROXY=
# Email (SMTP) and SMS (Twilio) delivery: set them in Admin > Settings; these are optional fallbacks (each group all-or-nothing).
# With neither set, development prints messages to the console and production refuses to send.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="BookaTurf <no-reply@bookaturf.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts owners' Stripe keys at rest; required in production.
# PAYMENTS_ENCRYPTION_KEY=
