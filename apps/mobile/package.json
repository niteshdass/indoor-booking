    "react-test-renderer": "19.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "tokens": "tsx scripts/gen-tokens.ts",
    "icons": "tsx scripts/gen-icons.ts",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterEnv": [
      "<rootDir>/test/setup.ts"
