MONGODB_URI=mongodb://localhost:27017/booking?replicaSet=rs0
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
# Auth: JWT_SECRET must be at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Optional fallback: set the Google client ID in Admin > Settings instead. The button is hidden while neither is set.
GOOGLE_CLIENT_ID=
# Web app URL used in password-reset links and notification messages (required in production)
APP_URL=http://localhost:5173
# Set behind a reverse proxy/load balancer so rate limits see real client IPs (e.g. 1, loopback)
TRUST_PROXY=
# Email (SMTP) and SMS (Twilio) delivery: set them in Admin > Settings; these are optional fallbacks (each group all-or-nothing).
# With neither set, development prints messages to the console and production refuses to send.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="Slots <no-reply@example.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts owners' Stripe keys at rest; required in production.
# PAYMENTS_ENCRYPTION_KEY=

# Public demo only (see docs/demo.md): one-tap role sign-in on the login page, API keys and account details locked.
# DEMO_MODE=false
