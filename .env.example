MONGODB_URI=mongodb://localhost:27017/booking?replicaSet=rs0
PORT=4000
CORS_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:4000/api/v1
# Auth: JWT_SECRET must be at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=
# Optional; Google sign-in returns 503 until set
GOOGLE_CLIENT_ID=
# Same value as GOOGLE_CLIENT_ID; the Google button is hidden while empty
VITE_GOOGLE_CLIENT_ID=
# Web app URL used in password-reset links and notification messages (required in production)
APP_URL=http://localhost:5173
# Set behind a reverse proxy/load balancer so rate limits see real client IPs (e.g. 1, loopback)
TRUST_PROXY=
# Email (SMTP) and SMS (Twilio) delivery; each group is all-or-nothing and both are required in production.
# Unset in development, messages are printed to the console.
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM="Slots <no-reply@example.com>"
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15550001111

# 32 random bytes, base64 (openssl rand -base64 32). Encrypts owners' Stripe keys at rest; required in production.
# PAYMENTS_ENCRYPTION_KEY=
